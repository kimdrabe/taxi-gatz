---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import site from '../data/site.json';
import contact from '../data/contact.json';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
}

const { title, description, canonical, image } = Astro.props;
const siteHost = 'https://kimdrabe.github.io';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = Astro.url.pathname;
const pageUrl = canonical || `${siteHost}${pagePath}`;
const schemaUrl = `${siteHost}${basePath}`;
const ogTitle = `${title} | Taxi & Mietwagen Gatz`;
const ogDesc = description || site.site_description;
const ogImage = image || (site.og_image ? `${siteHost}${basePath}${site.og_image}` : '');

const cityName = contact.city.replace(/^\d+\s*/, '') || "Overath";
const zipMatch = contact.city.match(/\d{5}/);
const zipCode = zipMatch ? zipMatch[0] : "51491";
const phoneIntl = `+49${contact.phone.replace(/\s/g, '').replace(/^0/, '')}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ogDesc} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#111111" />
    <meta name="keywords" content={site.keywords} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Taxi & Mietwagen Gatz" />
    <meta property="og:locale" content="de_DE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Overath" />
    <meta name="geo.position" content="50.9327;7.2829" />
    <meta name="ICBM" content="50.9327, 7.2829" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": contact.company,
      "image": ogImage,
      "url": schemaUrl,
      "telephone": phoneIntl,
      "email": contact.email,
      "description": site.site_description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": contact.street,
        "addressLocality": cityName,
        "postalCode": zipCode,
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9327,
        "longitude": 7.2829
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "foundingDate": "2002",
      "numberOfEmployees": 8,
      "areaServed": [
        {"@type": "City", "name": "Overath"},
        {"@type": "City", "name": "Rösrath"},
        {"@type": "City", "name": "Lohmar"},
        {"@type": "City", "name": "Much"},
        {"@type": "City", "name": "Engelskirchen"},
        {"@type": "City", "name": "Lindlar"},
        {"@type": "City", "name": "Köln"},
        {"@type": "City", "name": "Bergisch Gladbach"},
        {"@type": "City", "name": "Gummersbach"}
      ],
      "priceRange": "€€",
      "sameAs": [
        contact.facebook,
        contact.instagram
      ]
    })} />

    <title>{title} | Taxi & Mietwagen Gatz</title>

    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${basePath}/apple-touch-icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${basePath}/sitemap.xml`} />
  </head>
  <body class="overflow-x-hidden">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
