---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const site = 'https://taxi-gatz.de';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical || `${site}${Astro.url.pathname}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical || `${site}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="Taxi & Mietwagen Gatz" />
    <meta property="og:locale" content="de_DE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Taxi & Mietwagen Gatz",
      "image": `${site}/og-image.jpg`,
      "url": site,
      "telephone": "+492206123456",
      "email": "info@taxi-gatz.de",
      "description": "Familiengeführtes Taxiunternehmen aus Overath seit 2002. Taxi, Mietwagen, Krankentransporte, Schülerfahrten und mehr.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kleinhurden 3",
        "addressLocality": "Overath",
        "postalCode": "51491",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9327,
        "longitude": 7.2829
      },
      "openingHours": "Mo-Su 00:00-24:00",
      "foundingDate": "2002",
      "numberOfEmployees": 8,
      "areaServed": ["Overath", "Rösrath", "Lohmar", "Much", "Engelskirchen", "Lindlar", "Köln", "Bergisch Gladbach", "Gummersbach"],
      "priceRange": "€€",
      "sameAs": [
        "https://www.facebook.com/taxigatz",
        "https://www.instagram.com/taxigatz"
      ]
    })} />

    <title>{title} | Taxi & Mietwagen Gatz</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="overflow-x-hidden">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
