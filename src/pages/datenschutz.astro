---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const entry = await getEntry('datenschutz', 'datenschutz');
const content = entry ? marked.parse(entry.body) : '';
const title = entry?.data?.title || 'Datenschutzerklärung';
---

<Layout title="Datenschutz" description="Datenschutzerklärung der Taxi & Mietwagen Gatz in Overath.">
  <section class="pt-28 pb-16 md:pt-36 md:pb-24 bg-taxi-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-5xl font-display font-bold text-taxi-white mb-4">{title}</h1>
    </div>
  </section>

  <section class="section-padding bg-taxi-white">
    <div class="container-narrow max-w-3xl">
      <div class="prose prose-gray max-w-none" set:html={content}></div>
    </div>
  </section>
</Layout>
