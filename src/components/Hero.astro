---

---

<section class="relative min-h-screen flex items-center overflow-hidden bg-taxi-black">
  <div class="absolute inset-0 bg-gradient-to-br from-taxi-black via-taxi-black-light to-taxi-gray-900"></div>
  <div class="absolute inset-0 bg-grid-pattern opacity-50"></div>

  <div class="absolute top-1/3 -right-32 w-96 h-96 bg-taxi-yellow/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/4 -left-32 w-80 h-80 bg-taxi-yellow/3 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 md:pt-28 md:pb-24 w-full">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-taxi-yellow/10 border border-taxi-yellow/20 rounded-full mb-6 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-taxi-yellow animate-pulse-soft"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-taxi-yellow">Rund um die Uhr für Sie da</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold text-taxi-white leading-[1.1] mb-6 animate-slide-up text-balance">
        Ihr zuverlässiges Taxi in <span class="text-taxi-yellow">Overath</span>
      </h1>

      <p class="text-lg md:text-xl text-taxi-gray-400 leading-relaxed max-w-2xl mb-8 animate-slide-up" style="animation-delay: 0.15s;">
        Familiengeführt und persönlich – wir bringen Sie sicher ans Ziel. Ob Kurzstrecke, Flughafen oder Krankentransport.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 animate-slide-up" style="animation-delay: 0.3s;">
        <a href="tel:+492206123456" class="btn-primary text-lg !py-5 !px-10 gap-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Jetzt anrufen
        </a>
        <a href="/kontakt" class="btn-outline text-lg !py-5 !px-10">
          Kontaktformular
        </a>
      </div>

      <div class="flex flex-wrap gap-6 mt-12 animate-fade-in" style="animation-delay: 0.45s;">
        <div class="flex items-center gap-2 text-sm text-taxi-gray-400">
          <svg class="w-5 h-5 text-taxi-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          24/7 Verfügbar
        </div>
        <div class="flex items-center gap-2 text-sm text-taxi-gray-400">
          <svg class="w-5 h-5 text-taxi-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Overath & Umgebung
        </div>
        <div class="flex items-center gap-2 text-sm text-taxi-gray-400">
          <svg class="w-5 h-5 text-taxi-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Seit 2002
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-taxi-gray-100 to-transparent"></div>
</section>
