---
import services from '../data/services.json';
import contactData from '../data/contact.json';

const phoneClean = `+49${contactData.phone.replace(/\s/g, '').replace(/^0/, '')}`;
---

<section id="kontakt" class="section-padding bg-taxi-white">
  <div class="container-narrow">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <span class="inline-block px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-taxi-yellow-dark bg-taxi-yellow/10 rounded-full mb-4">
          Kontakt
        </span>
        <h2 class="text-3xl md:text-4xl font-display font-bold text-taxi-black mb-6 text-balance">
          Wir sind für Sie da
        </h2>
        <p class="text-taxi-gray-600 mb-8 leading-relaxed">{contactData.company} – Ihre Fahrten, unser Service.</p>

        <div class="space-y-6 mb-8">
          <a href={`tel:${phoneClean}`} class="flex items-center gap-4 group">
            <span class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-2xl bg-taxi-yellow/10 group-hover:bg-taxi-yellow/20 transition-colors duration-300">
              <svg class="w-6 h-6 text-taxi-yellow-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <div>
              <span class="block text-sm text-taxi-gray-500">Telefon</span>
              <span class="block text-lg font-bold text-taxi-black group-hover:text-taxi-yellow-dark transition-colors">{contactData.phone}</span>
            </div>
          </a>

          <a href={`mailto:${contactData.email}`} class="flex items-center gap-4 group">
            <span class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-2xl bg-taxi-yellow/10 group-hover:bg-taxi-yellow/20 transition-colors duration-300">
              <svg class="w-6 h-6 text-taxi-yellow-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <div>
              <span class="block text-sm text-taxi-gray-500">E-Mail</span>
              <span class="block text-lg font-bold text-taxi-black group-hover:text-taxi-yellow-dark transition-colors">{contactData.email}</span>
            </div>
          </a>

          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-2xl bg-taxi-yellow/10">
              <svg class="w-6 h-6 text-taxi-yellow-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <div>
              <span class="block text-sm text-taxi-gray-500">Adresse</span>
              <address class="block not-italic text-lg font-bold text-taxi-black">{contactData.address}</address>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-2xl bg-taxi-yellow/10">
              <svg class="w-6 h-6 text-taxi-yellow-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <div>
              <span class="block text-sm text-taxi-gray-500">Öffnungszeiten</span>
              <span class="block text-lg font-bold text-taxi-black">{contactData.hours}</span>
            </div>
          </div>
        </div>

        <a href={`tel:${phoneClean}`} class="btn-primary w-full sm:w-auto text-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Jetzt anrufen – {contactData.phone}
        </a>
      </div>

      <div class="bg-taxi-gray-100 rounded-3xl p-6 md:p-8">
        <h3 class="text-xl font-bold text-taxi-black mb-6">Schreiben Sie uns</h3>
        <form action={`mailto:${contactData.email}`} method="post" enctype="text/plain" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-taxi-gray-700 mb-1.5">Name *</label>
              <input type="text" id="name" name="name" required
                class="w-full px-4 py-3 bg-taxi-white border border-gray-200 rounded-xl text-sm text-taxi-black placeholder:text-taxi-gray-400 focus:ring-2 focus:ring-taxi-yellow focus:border-transparent outline-none transition-all"
                placeholder="Ihr Name" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-taxi-gray-700 mb-1.5">E-Mail *</label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-3 bg-taxi-white border border-gray-200 rounded-xl text-sm text-taxi-black placeholder:text-taxi-gray-400 focus:ring-2 focus:ring-taxi-yellow focus:border-transparent outline-none transition-all"
                placeholder="ihre@email.de" />
            </div>
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-taxi-gray-700 mb-1.5">Telefon</label>
            <input type="tel" id="phone" name="phone"
              class="w-full px-4 py-3 bg-taxi-white border border-gray-200 rounded-xl text-sm text-taxi-black placeholder:text-taxi-gray-400 focus:ring-2 focus:ring-taxi-yellow focus:border-transparent outline-none transition-all"
              placeholder="02206 ..." />
          </div>
          <div>
            <label for="service" class="block text-sm font-medium text-taxi-gray-700 mb-1.5">Leistung *</label>
            <select id="service" name="service" required
              class="w-full px-4 py-3 bg-taxi-white border border-gray-200 rounded-xl text-sm text-taxi-black focus:ring-2 focus:ring-taxi-yellow focus:border-transparent outline-none transition-all appearance-none">
              <option value="">Bitte wählen...</option>
              {services.map(s => (
                <option value={s.title}>{s.title}</option>
              ))}
              <option value="sonstiges">Sonstiges</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-taxi-gray-700 mb-1.5">Nachricht *</label>
            <textarea id="message" name="message" rows="4" required
              class="w-full px-4 py-3 bg-taxi-white border border-gray-200 rounded-xl text-sm text-taxi-black placeholder:text-taxi-gray-400 focus:ring-2 focus:ring-taxi-yellow focus:border-transparent outline-none transition-all resize-none"
              placeholder="Ihre Nachricht an uns..."></textarea>
          </div>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="privacy" name="privacy" required
              class="mt-1 w-4 h-4 rounded border-gray-300 text-taxi-yellow focus:ring-taxi-yellow" />
            <label for="privacy" class="text-xs text-taxi-gray-500">
              Ich stimme der <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/datenschutz`} class="text-taxi-yellow-dark underline hover:text-taxi-yellow">Datenschutzerklärung</a> zu. *
            </label>
          </div>
          <button type="submit" class="btn-primary w-full">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Nachricht senden
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
