---
const currentYear = new Date().getFullYear();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<footer class="bg-taxi-black border-t border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <span class="flex items-center justify-center w-10 h-10 bg-taxi-yellow rounded-lg text-taxi-black font-extrabold text-lg">
            G
          </span>
          <div>
            <span class="block text-base font-bold text-taxi-white leading-tight">Taxi & Mietwagen</span>
            <span class="block text-sm font-medium text-taxi-yellow leading-tight">Gatz</span>
          </div>
        </div>
        <p class="text-sm text-taxi-gray-400 leading-relaxed mb-6">
          Familiengeführtes Taxiunternehmen aus Overath. Seit 2002 für Sie unterwegs.
        </p>
        <div class="flex gap-3">
          <a href="https://www.facebook.com/taxigatz" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 text-taxi-gray-400 hover:bg-taxi-yellow hover:text-taxi-black transition-all duration-300" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
          <a href="https://www.instagram.com/taxigatz" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 text-taxi-gray-400 hover:bg-taxi-yellow hover:text-taxi-black transition-all duration-300" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 016.11 2.525c.636-.247 1.363-.416 2.427-.465C8.88 2.013 9.235 2 11.665 2h.63zm-.08 1.802h-.47c-2.583 0-2.916.011-3.93.057-.943.043-1.455.2-1.796.332-.452.174-.774.383-1.113.722-.339.34-.548.662-.722 1.113-.132.341-.29.854-.332 1.796-.046 1.014-.057 1.347-.057 3.93v.47c0 2.583.011 2.916.057 3.93.043.943.2 1.455.332 1.796.174.452.383.774.722 1.113.34.339.662.548 1.113.722.341.132.854.29 1.796.332 1.014.046 1.347.057 3.93.057h.47c2.583 0 2.916-.011 3.93-.057.943-.043 1.455-.2 1.796-.332.452-.174.774-.383 1.113-.722.34-.339.548-.662.722-1.113.132-.341.29-.854.332-1.796.046-1.014.057-1.347.057-3.93v-.47c0-2.583-.011-2.916-.057-3.93-.043-.943-.2-1.455-.332-1.796-.174-.452-.383-.774-.722-1.113a3.11 3.11 0 00-1.113-.722c-.341-.132-.854-.29-1.796-.332-1.014-.046-1.347-.057-3.93-.057zm-3.25 4.543a4.88 4.88 0 110 9.76 4.88 4.88 0 010-9.76zm0 2.01a2.87 2.87 0 100 5.74 2.87 2.87 0 000-5.74zm5.94-2.15a1.14 1.14 0 110 2.28 1.14 1.14 0 010-2.28z" />
            </svg>
          </a>
          <a href="https://wa.me/492206123456" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 text-taxi-gray-400 hover:bg-taxi-yellow hover:text-taxi-black transition-all duration-300" aria-label="WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-bold text-taxi-white uppercase tracking-wider mb-4">Leistungen</h4>
        <ul class="space-y-3">
          {[
            'Taxi', 'Mietwagen', 'Krankentransporte', 'Schülerfahrten',
            'Flughafenfahrten', 'Fernfahrten', 'Kurierfahrten'
          ].map(item => (
            <li>
              <a href={`${BASE}/#leistungen`} class="text-sm text-taxi-gray-400 hover:text-taxi-yellow transition-colors">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-taxi-white uppercase tracking-wider mb-4">Service</h4>
        <ul class="space-y-3">
          <li><a href={`${BASE}/#karriere`} class="text-sm text-taxi-gray-400 hover:text-taxi-yellow transition-colors">Karriere</a></li>
          <li><a href={`${BASE}/#kontakt`} class="text-sm text-taxi-gray-400 hover:text-taxi-yellow transition-colors">Kontakt</a></li>
          <li><a href={`${BASE}/#bewertungen`} class="text-sm text-taxi-gray-400 hover:text-taxi-yellow transition-colors">Bewertungen</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-taxi-white uppercase tracking-wider mb-4">Kontakt</h4>
        <ul class="space-y-3 text-sm text-taxi-gray-400">
          <li>
            <a href="tel:+492206123456" class="hover:text-taxi-yellow transition-colors font-bold text-taxi-white">
              02206 123456
            </a>
          </li>
          <li>
            <a href="mailto:info@taxi-gatz.de" class="hover:text-taxi-yellow transition-colors">
              info@taxi-gatz.de
            </a>
          </li>
          <li class="not-italic">
            Kleinhurden 3<br />
            51491 Overath
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-taxi-gray-500">
        &copy; {currentYear} Taxi & Mietwagen Gatz. Alle Rechte vorbehalten.
      </p>
      <div class="flex gap-6">
        <a href={`${BASE}/impressum`} class="text-xs text-taxi-gray-500 hover:text-taxi-yellow transition-colors">Impressum</a>
        <a href={`${BASE}/datenschutz`} class="text-xs text-taxi-gray-500 hover:text-taxi-yellow transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
