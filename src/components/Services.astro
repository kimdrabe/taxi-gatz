---
import services from '../data/services.json';
import contact from '../data/contact.json';

const sorted = services.sort((a, b) => a.order - b.order);
---

<section id="leistungen" class="section-padding bg-taxi-gray-100">
  <div class="container-narrow">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-taxi-yellow-dark bg-taxi-yellow/10 rounded-full mb-4">
        Unsere Leistungen
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-taxi-black mb-4 text-balance">
        Alle Fahrten aus einer Hand
      </h2>
      <p class="text-taxi-gray-600 text-lg max-w-2xl mx-auto">
        Ob Kurzstrecke oder Fernfahrt – wir bringen Sie sicher ans Ziel.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {sorted.map((service, index) => (
        <article
          class="group relative bg-taxi-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-xl transition-all duration-500 border border-gray-100 hover:border-taxi-yellow/30 hover:-translate-y-1"
          style={`animation: slideUpSm 0.5s ease-out ${index * 0.05}s forwards; opacity: 0;`}
        >
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-taxi-yellow/10 text-2xl group-hover:scale-110 transition-transform duration-300">
              {service.icon}
            </span>
            <div>
              <h3 class="text-lg font-bold text-taxi-black mb-2">{service.title}</h3>
              <p class="text-sm text-taxi-gray-600 leading-relaxed">{service.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-10">
      <p class="text-taxi-gray-600 mb-4 text-sm">
        Nicht sicher, welche Leistung die richtige ist? Wir beraten Sie gern.
      </p>
      <a href={`tel:+49${contact.phone.replace(/\s/g, '').replace(/^0/, '')}`} class="btn-primary">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Jetzt anrufen – {contact.phone}
      </a>
    </div>
  </div>
</section>
