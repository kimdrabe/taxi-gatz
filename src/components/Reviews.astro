---
import { getCollection } from 'astro:content';

const reviewEntries = await getCollection('reviews');
const sorted = reviewEntries.sort((a, b) => a.data.order - b.data.order);
---

<section id="bewertungen" class="section-padding bg-taxi-gray-100">
  <div class="container-narrow">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-taxi-yellow-dark bg-taxi-yellow/10 rounded-full mb-4">
        Bewertungen
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-taxi-black mb-4 text-balance">
        Was unsere Fahrgäste sagen
      </h2>
      <p class="text-taxi-gray-600 text-lg max-w-2xl mx-auto">
        Ihre Zufriedenheit ist unser größter Antrieb.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((review, index) => (
        <blockquote
          class="bg-taxi-white rounded-2xl p-6 shadow-sm border border-gray-100"
          style={`animation: slideUpSm 0.5s ease-out ${index * 0.05}s forwards; opacity: 0;`}
        >
          <div class="flex gap-0.5 mb-4" aria-label={`${review.data.rating} von 5 Sternen`}>
            {Array.from({ length: 5 }, (_, i) => (
              <svg
                class={`w-5 h-5 ${i < review.data.rating ? 'text-taxi-yellow' : 'text-gray-200'}`}
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-sm text-taxi-gray-700 leading-relaxed mb-4 italic">"{review.data.text}"</p>
          <footer class="text-sm font-bold text-taxi-black">— {review.data.name}</footer>
        </blockquote>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="https://search.google.com/local/writereview?placeid=PLACE_ID_HERE"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        Bewertung schreiben
      </a>
    </div>
  </div>
</section>
